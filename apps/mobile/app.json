{
  "expo": {
    "name": "Fixa",
    "slug": "fixa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fixa",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "me.sectiontn.fixa",
      "appleTeamId": "283L98RV99",
      "supportsTablet": false
    },
    "android": {
      "package": "me.sectiontn.fixa",
      "adaptiveIcon": {
        "backgroundColor": "#BF5535",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.50035838261-73ornk942ad453vo5h1n88a3hek3kckj"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
